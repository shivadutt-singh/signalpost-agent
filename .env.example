# ==============================================================================
# Signalpost Agent - Configuration Environment Variables
# ==============================================================================

# Primary LLM Engine: NVIDIA NIM Microservices (Default)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_FALLBACK_MODEL=qwen/qwen2.5-72b-instruct
NVIDIA_RPM_LIMIT=38

# Optional Alternate Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Strict Resource Budget & Caps
# Hard rules: strictly enforce max 18 outbound HTTP requests per company
MAX_HTTP_REQUESTS_PER_COMPANY=18
MAX_EXTERNAL_COST_USD_PER_100=9.50
TARGET_EXTERNAL_COST_USD_PER_COMPANY=0.015

# Concurrency & Performance
MAX_CONCURRENT_COMPANIES=10
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3

# Storage Paths
OUTPUT_DIR=./output
PROFILES_DIR=./output/profiles
DELTAS_DIR=./output/deltas
TELEMETRY_DIR=./output/telemetry

# Logging
LOG_LEVEL=INFO
